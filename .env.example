# ===================================================
# .env.example — Rappi-Stream
# Copia este archivo a .env y ajusta los valores.
# NUNCA subas el archivo .env al repositorio (.gitignore lo excluye).
# ===================================================

# --- PostgreSQL ---
POSTGRES_DB=rappi_stream_db
POSTGRES_USER=rappi_user
POSTGRES_PASSWORD=rappi_pass_2024

# --- RabbitMQ ---
RABBITMQ_DEFAULT_USER=rappi_admin
RABBITMQ_DEFAULT_PASS=rappi_rmq_2024

# --- Kafka KRaft ---
# UUID base64 de exactamente 22 caracteres.
# Para generar uno nuevo (dentro del contenedor Kafka):
#   docker run --rm confluentinc/cp-kafka:7.6.0 kafka-storage random-uuid
# O usar este valor fijo para desarrollo local:
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qg

# --- Puertos expuestos al host (desarrollo local) ---
ORDER_API_PORT=8080
ORDER_PROCESSOR_PORT=8081
DRIVER_SIMULATOR_PORT=8082
NOTIFICATION_ROUTER_PORT=8083
SMS_WORKER_PORT=8084
PUSH_WORKER_PORT=8085
DASHBOARD_AGGREGATOR_PORT=8086
DASHBOARD_BACKEND_PORT=8087

KAFKA_PORT=9092
RABBITMQ_AMQP_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
POSTGRES_PORT=5432
