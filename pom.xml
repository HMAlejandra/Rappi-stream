<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- ===================================================
         PARENT POM — RAPPI-STREAM
         Gestión centralizada de versiones y dependencias
         para todos los módulos del proyecto.
         =================================================== -->

    <groupId>com.rappistream</groupId>
    <artifactId>rappi-stream-parent</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>

    <name>Rappi-Stream Parent</name>
    <description>Plataforma de Logística en Tiempo Real — Proyecto Universitario</description>

    <!-- ===================================================
         MÓDULOS DEL PROYECTO
         Maven compila en este orden respetando dependencias
         =================================================== -->
    <modules>
        <module>common</module>
        <module>order_api</module>
        <module>order_processor</module>
        <module>driver_simulator</module>
        <module>notification_router</module>
        <module>sms_worker</module>
        <module>push_notification_worker</module>
        <module>dashboard_aggregator</module>
        <module>dashboard_backend</module>
    </modules>

    <!-- ===================================================
         SPRING BOOT PARENT
         Proporciona gestión de dependencias de Spring Boot
         y configuración del plugin de Maven
         =================================================== -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.5</version>
        <relativePath/>
    </parent>

    <!-- ===================================================
         PROPIEDADES GLOBALES
         Versiones fijadas para todo el proyecto
         =================================================== -->
    <properties>
        <!-- Java -->
        <java.version>17</java.version>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- Versiones de dependencias -->
        <spring-boot.version>3.2.5</spring-boot.version>
        <spring-kafka.version>3.1.4</spring-kafka.version>
        <jackson.version>2.16.1</jackson.version>
        <lombok.version>1.18.32</lombok.version>

        <!-- Versión interna del módulo common -->
        <rappistream.common.version>1.0.0</rappistream.common.version>
    </properties>

    <!-- ===================================================
         GESTIÓN DE DEPENDENCIAS
         Declara versiones sin añadir dependencias automáticamente.
         Cada módulo hijo elige cuáles incluir.
         =================================================== -->
    <dependencyManagement>
        <dependencies>

            <!-- Módulo de contratos compartidos -->
            <dependency>
                <groupId>com.rappistream</groupId>
                <artifactId>common</artifactId>
                <version>${rappistream.common.version}</version>
            </dependency>

            <!-- Spring Boot Starters -->
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-starter-web</artifactId>
                <version>${spring-boot.version}</version>
            </dependency>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-starter-amqp</artifactId>
                <version>${spring-boot.version}</version>
            </dependency>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-starter-data-jpa</artifactId>
                <version>${spring-boot.version}</version>
            </dependency>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-starter-websocket</artifactId>
                <version>${spring-boot.version}</version>
            </dependency>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-starter-validation</artifactId>
                <version>${spring-boot.version}</version>
            </dependency>

            <!-- Spring Kafka -->
            <dependency>
                <groupId>org.springframework.kafka</groupId>
                <artifactId>spring-kafka</artifactId>
                <version>${spring-kafka.version}</version>
            </dependency>

            <!-- Jackson para serialización JSON -->
            <dependency>
                <groupId>com.fasterxml.jackson.core</groupId>
                <artifactId>jackson-databind</artifactId>
                <version>${jackson.version}</version>
            </dependency>
            <dependency>
                <groupId>com.fasterxml.jackson.datatype</groupId>
                <artifactId>jackson-datatype-jsr310</artifactId>
                <version>${jackson.version}</version>
            </dependency>

            <!-- PostgreSQL Driver -->
            <dependency>
                <groupId>org.postgresql</groupId>
                <artifactId>postgresql</artifactId>
                <version>42.7.3</version>
            </dependency>

            <!-- Testing -->
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-starter-test</artifactId>
                <version>${spring-boot.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>org.springframework.kafka</groupId>
                <artifactId>spring-kafka-test</artifactId>
                <version>${spring-kafka.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>org.springframework.amqp</groupId>
                <artifactId>spring-rabbit-test</artifactId>
                <version>3.1.4</version>
                <scope>test</scope>
            </dependency>

        </dependencies>
    </dependencyManagement>

    <!-- ===================================================
         CONFIGURACIÓN DEL BUILD
         Plugin de Spring Boot para empaquetar JARs ejecutables
         =================================================== -->
    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <version>${spring-boot.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.12.1</version>
                    <configuration>
                        <source>17</source>
                        <target>17</target>
                        <encoding>UTF-8</encoding>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

</project>
